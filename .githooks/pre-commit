#!/bin/sh
# The fast tier of the gate (`make gate-fast`) before every commit. Installed once per
# clone by `make hooks`. It checks the working tree, not only what is staged.
set -eu
# Homebrew's Rust may sit earlier in PATH; cargo finds rustc through PATH.
export PATH="$HOME/.cargo/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"
exec make gate-fast </dev/null
