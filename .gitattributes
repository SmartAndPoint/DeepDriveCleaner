# Every text file is checked out with LF, Windows included (story "Build matrix:
# every target built, tested and packaged from one tag", DDC-007, stage 2). With
# CRLF the committed schemas read as stale and tests/structure.rs misreads
# Cargo.toml and the Makefile.
* text=auto eol=lf

# Fuzz regression inputs are bytes as the fuzzer found them: never converted.
fuzz/regressions/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
