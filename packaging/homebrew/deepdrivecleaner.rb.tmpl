# Rendered by scripts/publish-release.sh — do not edit in the tap by hand.
# Only the version and the checksum are substituted at publish time; everything
# else is the contract and changes here, in the source repository.
cask "deepdrivecleaner" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/SmartAndPoint/DeepDriveCleaner/releases/download/v#{version}/DeepDriveCleaner-#{version}.zip"
  name "DeepDriveCleaner"
  desc "Find and safely clean disk space taken by developer tools and projects"
  homepage "https://github.com/SmartAndPoint/DeepDriveCleaner"

  livecheck do
    url :url
    strategy :github_latest
  end

  # The menu bar app with the command-line tool inside (ADR "Menu bar app: Swift
  # shell over the ddc CLI", §8), signed with the SmartAndPoint Developer ID,
  # notarized and stapled. Apple Silicon and macOS 26 only: every test and
  # measurement ran there. On an older macOS the release's CLI tarball remains.
  # The app updates itself through Sparkle (ADR "Updates through Sparkle,
  # alongside the Homebrew cask"): `brew upgrade` leaves it alone, and
  # `brew upgrade --greedy deepdrivecleaner` reinstalls it from the cask.
  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :tahoe

  # One binary under two names, linked from inside the app, whose path stays the
  # same across upgrades.
  app "DeepDriveCleaner.app"
  binary "#{appdir}/DeepDriveCleaner.app/Contents/Helpers/deepdrivecleaner"
  binary "#{appdir}/DeepDriveCleaner.app/Contents/Helpers/deepdrivecleaner", target: "ddc"

  # Homebrew runs `uninstall` on every upgrade too: it quits the app, and leaves
  # the background agent of `ddc schedule install` running. `--zap` removes it.
  uninstall quit: "com.smartandpoint.deepdrivecleaner"

  zap launchctl: [
        "com.smartandpoint.deepdrivecleaner",
        "com.smartandpoint.deepdrivecleaner.scheduler",
        "com.smartandpoint.deepdrivecleaner.scheduler-open",
      ],
      trash:     [
        "~/Library/Application Support/DeepDriveCleaner",
        "~/Library/Caches/com.smartandpoint.deepdrivecleaner",
        "~/Library/HTTPStorages/com.smartandpoint.deepdrivecleaner",
        "~/Library/LaunchAgents/com.smartandpoint.deepdrivecleaner.plist",
        "~/Library/Logs/DeepDriveCleaner",
        "~/Library/Preferences/com.smartandpoint.deepdrivecleaner.plist",
      ]

  caveats <<~EOS
    DeepDriveCleaner deletes files and can remove almost anything it is told to.
    You use it at your own risk:
      https://github.com/SmartAndPoint/DeepDriveCleaner/blob/main/DISCLAIMER.md

    Open DeepDriveCleaner from Applications and give it Full Disk Access when it
    asks. `ddc` run from Terminal uses Terminal's own access.

    A background scan from `ddc schedule install` runs
      #{appdir}/DeepDriveCleaner.app/Contents/Helpers/deepdrivecleaner
    To let it scan all of ~/Library, add that path to Full Disk Access once
    (press Shift-Cmd-G in the file picker to paste it). Before `brew uninstall`,
    run `ddc schedule uninstall`, or uninstall with `brew uninstall --zap`.
  EOS
end
