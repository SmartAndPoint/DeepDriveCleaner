<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The scheduler (ADR "Menu bar app: Swift shell over the ddc CLI", §5), registered
     by the app with SMAppService.agent. An hourly tick asks LaunchServices for the
     app, so the scan runs in a process LaunchServices started and Full Disk Access
     granted to the app applies; the app decides whether a scan is due. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.smartandpoint.deepdrivecleaner.scheduler</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-gjb</string>
		<string>com.smartandpoint.deepdrivecleaner</string>
		<string>--args</string>
		<string>--scheduled</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
