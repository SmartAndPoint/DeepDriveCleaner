<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The scheduler's fallback (B6): registered only when macOS refuses the bundle
     program of ...scheduler.plist. The same hourly tick, through /usr/bin/open by
     bundle id. Its own label, so the two are never confused. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.smartandpoint.deepdrivecleaner.scheduler-open</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-gjb</string>
		<string>com.smartandpoint.deepdrivecleaner</string>
		<string>--args</string>
		<string>--scheduled</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
