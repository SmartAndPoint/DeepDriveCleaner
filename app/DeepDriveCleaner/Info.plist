<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>DeepDriveCleaner</string>
	<key>CFBundleDisplayName</key>
	<string>DeepDriveCleaner</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The version lives only in project.pbxproj (MARKETING_VERSION,
	     CURRENT_PROJECT_VERSION); MARKETING_VERSION matches the CLI's Cargo version. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 SmartAndPoint. PolyForm Noncommercial License 1.0.0.</string>
	<!-- Sparkle (ADR "Updates through Sparkle, alongside the Homebrew cask", §1): a
	     check at most daily, on by default; install only on Update and Relaunch.
	     System profiling and Sparkle's XPC services stay off (keys not set).
	     SUPublicEDKey is the public half of the owner's `generate_keys` key, whose
	     private half stays in the owner's keychain; build-app.sh --dist refuses
	     anything but an EdDSA public key here. -->
	<key>SUFeedURL</key>
	<string>https://github.com/SmartAndPoint/DeepDriveCleaner/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>MwO79np4MPskuB2YpRXZo22v/ELI5bo8sJ2q1jIJdVs=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- The default, kept explicit: a key rotation ships in the same zip. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<false/>
</dict>
</plist>
