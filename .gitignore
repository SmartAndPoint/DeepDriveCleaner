/target/
# Coverage data from CLI test children, which clear the environment (make coverage).
*.profraw
.DS_Store
.claude/settings.local.json
__pycache__/
# The repository root's scratch folder (the owner's screen recordings).
/tmp/

# Coverage data from the reference machine lists personal folder names: it stays local.
/bench/baseline-*.tsv
/bench/devartifacts-*.txt

# Release builds and the maintainer's local signing settings.
/dist/
.env

# App builds (scripts/build-app.sh), Swift package builds and Xcode user state.
/build/
.build/
.swiftpm/
xcuserdata/
