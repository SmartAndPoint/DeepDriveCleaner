# Copy to .env (never committed). Maintainers only: `make dist` signs and notarizes.
# SHA-1 of the Developer ID Application certificate (security find-identity -v -p codesigning);
# the hash, not the name, which is ambiguous when the keychain holds two certificates.
DDC_SIGN_IDENTITY=
# notarytool keychain profile (xcrun notarytool store-credentials <name> --team-id <team>).
NOTARY_PROFILE=
