{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentsReport",
  "description": "What coding-agent harnesses keep under the home folder, and their\nsessions (story \"Coding agents in the Whole disk view\"). Read-only, and\nnever stored: liveness is read again on every run.",
  "type": "object",
  "properties": {
    "ddc_version": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "generated_at": {
      "description": "RFC 3339, UTC.",
      "type": "string"
    },
    "harnesses": {
      "description": "The harnesses with at least one folder, in the table's order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Harness"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sizes": {
      "description": "Whether the folders were walked; `false` under `--no-sizes`, and then\nevery `bytes` is absent.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "ddc_version",
    "generated_at",
    "duration_ms",
    "sizes",
    "harnesses"
  ],
  "$defs": {
    "Folder": {
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes, each inode once; absent without sizes or when skipped.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "nested": {
          "description": "Lies inside the harness's folder above it; its bytes are in that one's.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "skipped": {
          "description": "At or under a skip of `settings.json`: never opened, no bytes.",
          "type": "boolean"
        },
        "unreadable": {
          "description": "Folders and entries inside that could not be read: `bytes` is then a\nlower bound.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "nested",
        "skipped",
        "unreadable"
      ]
    },
    "FootprintState": {
      "description": "Whether a session's files are still in use, as the cleanup's session\ncheck would decide now.",
      "type": "string",
      "enum": [
        "live",
        "not-live",
        "unknown"
      ]
    },
    "Harness": {
      "type": "object",
      "properties": {
        "bytes": {
          "description": "The top-level folders' bytes summed; absent without sizes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "folders": {
          "description": "The folders that exist; a nested one lies inside the one before it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Folder"
          }
        },
        "id": {
          "$ref": "#/$defs/HarnessId"
        },
        "name": {
          "description": "\"Claude Code\".",
          "type": "string"
        },
        "running": {
          "description": "Its processes that run now, by pid.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Running"
          }
        },
        "sessions": {
          "description": "Claude Code and Codex only.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sessions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "running",
        "folders"
      ]
    },
    "HarnessId": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "cursor",
        "opencode"
      ]
    },
    "LiveBy": {
      "description": "What shows a session live. The scan report's `live-session` lock\ncarries it as `by`.",
      "oneOf": [
        {
          "description": "A live record names it.",
          "type": "string",
          "const": "record"
        },
        {
          "description": "Its transcript or a companion changed within [`entries::RECENT`]\nbefore the check, or later than it.",
          "type": "string",
          "const": "recent"
        },
        {
          "description": "A process of the user holds one of its files open.",
          "type": "string",
          "const": "open-file"
        }
      ]
    },
    "RecordsState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "readable"
          ]
        },
        {
          "description": "No session is called stale then: a changed format must not read as\n\"everything ended\".",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Running": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RunningKind"
        },
        "pid": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "pid",
        "kind"
      ]
    },
    "RunningKind": {
      "description": "What ddc makes of a harness process.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "cli",
            "app"
          ]
        },
        {
          "description": "Codex's daemon, which holds the threads its app has open.",
          "type": "string",
          "const": "app-server"
        },
        {
          "description": "A binary of the harness that ddc cannot name, such as one inside\nanother app's bundle.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "entrypoint": {
          "description": "As Claude Code wrote it (`cli`, `claude-desktop`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Claude Code's `sessionId`, or the Codex thread id.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollout_time": {
          "description": "The time in a Codex rollout's file name, as written there\n(`2026-10-28T09-41-07`); its time zone is not known.",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "RFC 3339, UTC, from Claude Code's `startedAt`.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "status": {
          "description": "As Claude Code wrote it (`idle`, `busy`, …).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state"
      ]
    },
    "SessionFootprint": {
      "description": "What one Claude Code session keeps on disk, by kind; allocated bytes.",
      "type": "object",
      "properties": {
        "checkpoints": {
          "description": "`~/.claude/file-history/<id>`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "description": "The session id, a UUID.",
          "type": "string"
        },
        "live_by": {
          "description": "What shows it live; with `live` only.",
          "anyOf": [
            {
              "$ref": "#/$defs/LiveBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "modified": {
          "description": "RFC 3339, UTC: the latest change of its transcript or a companion.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "The project folder's name in `~/.claude/projects` (or in the\ntemporary folder), as Claude Code wrote it; absent when only the\ncheckpoints name the session.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/FootprintState"
        },
        "temp": {
          "description": "`<temp_root>/<project>/<id>`: its scratchpad, tasks and images.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "temp_path": {
          "description": "Its temporary folder, when it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transcript": {
          "description": "`~/.claude/projects/<project>/<id>.jsonl` and its companions.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unknown_cause": {
          "description": "Why its state is not known; with `unknown` only.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnknownCause"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "state",
        "transcript",
        "checkpoints",
        "temp",
        "total"
      ]
    },
    "SessionState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "live"
          ]
        },
        {
          "description": "A record left behind with no live process.",
          "type": "string",
          "const": "stale"
        },
        {
          "description": "The record lacks what the test needs.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Sessions": {
      "type": "object",
      "properties": {
        "footprints": {
          "description": "Claude Code only, with sizes: what each session keeps, largest\ntotal first. A session that ended has no record, so this is a list\nof its own, by session id.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SessionFootprint"
          }
        },
        "list": {
          "description": "Live first, then by start, then by id.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Session"
          }
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnknownReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "records": {
          "$ref": "#/$defs/RecordsState"
        },
        "temp_root": {
          "description": "Claude Code only, with sizes: its temporary folder outside the home\nfolder (`/private/tmp/claude-<uid>` on macOS), when it exists. Its\nbytes are in no folder of the harness.",
          "anyOf": [
            {
              "$ref": "#/$defs/TempRoot"
            },
            {
              "type": "null"
            }
          ]
        },
        "transcripts": {
          "$ref": "#/$defs/Transcripts"
        }
      },
      "required": [
        "records",
        "list",
        "transcripts"
      ]
    },
    "TempRoot": {
      "description": "Claude Code's temporary folder for the current user.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes, sessions and the rest (`bash-edit-diff`, …);\nabsent when skipped.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "description": "Canonical.",
          "type": "string"
        },
        "skipped": {
          "description": "At or under a skip of `settings.json`: never opened, no bytes.",
          "type": "boolean"
        },
        "unreadable": {
          "description": "Folders and entries inside that could not be read: `bytes` is then a\nlower bound.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "skipped",
        "unreadable"
      ]
    },
    "Transcripts": {
      "description": "The transcripts that no live session writes.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes; absent without sizes or when skipped.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "count": {
          "description": "From their names; absent when their folder is skipped.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "skipped": {
          "type": "boolean"
        }
      },
      "required": [
        "skipped"
      ]
    },
    "UnknownCause": {
      "description": "Why a session's liveness could not be told. Declared from the widest\nto the narrowest: when several apply, the first is reported. The scan\nreport's `liveness-unknown` lock carries it as `cause`.",
      "oneOf": [
        {
          "description": "The records folder does not exist: an older Claude Code, or a\nchanged layout.",
          "type": "string",
          "const": "records-missing"
        },
        {
          "description": "The records folder, or an entry of it, could not be read.",
          "type": "string",
          "const": "records-unreadable"
        },
        {
          "description": "The records folder lies at or under one of the user's skips, so it\nis never opened.",
          "type": "string",
          "const": "records-skipped"
        },
        {
          "description": "A record could not be parsed.",
          "type": "string",
          "const": "unparsable-record"
        },
        {
          "description": "A record could not be decided and names no session.",
          "type": "string",
          "const": "undecidable-record"
        },
        {
          "description": "A live record names no session.",
          "type": "string",
          "const": "live-record-without-session"
        },
        {
          "description": "A record that could not be decided names this session.",
          "type": "string",
          "const": "undecidable-session-record"
        },
        {
          "description": "The session was given with no file, so nothing could be checked.",
          "type": "string",
          "const": "session-without-files"
        }
      ]
    },
    "UnknownReason": {
      "oneOf": [
        {
          "description": "The records folder does not exist.",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The records folder could not be listed.",
          "type": "string",
          "const": "unreadable"
        },
        {
          "description": "None of the candidate records parsed.",
          "type": "string",
          "const": "unparsed"
        },
        {
          "description": "At or under a skip of `settings.json`.",
          "type": "string",
          "const": "skipped"
        }
      ]
    }
  }
}
