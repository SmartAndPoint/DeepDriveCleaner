{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanReport",
  "type": "object",
  "properties": {
    "cancelled": {
      "type": "boolean"
    },
    "ddc_version": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "errors_total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "findings": {
      "description": "Ordered by class, then size (largest first), then path.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "full_disk_access": {
      "description": "Whether the scanning process could read TCC-protected data. Without it\nparts of `~/Library` are unreadable and listed in `inaccessible`.",
      "type": "boolean"
    },
    "generated_at": {
      "description": "RFC 3339, UTC.",
      "type": "string"
    },
    "home": {
      "type": "string"
    },
    "inaccessible": {
      "description": "Directories that could not be read (at most 10 000; see `errors_total`).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Inaccessible"
      }
    },
    "large_files": {
      "description": "Largest files outside every finding, for manual review.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LargeFile"
      }
    },
    "min_age_days": {
      "description": "`rebuildable` findings idle at least this long are selected by default.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "scan_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkippedPath"
      }
    },
    "skipped_total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    },
    "volumes": {
      "description": "The volume of each scan root, once per volume. Absent when no volume\ncould be read.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Volume"
      }
    }
  },
  "required": [
    "schema_version",
    "ddc_version",
    "generated_at",
    "duration_ms",
    "home",
    "scan_roots",
    "full_disk_access",
    "min_age_days",
    "totals",
    "findings",
    "large_files",
    "inaccessible",
    "errors_total",
    "skipped",
    "skipped_total",
    "cancelled"
  ],
  "$defs": {
    "Backup": {
      "type": "object",
      "properties": {
        "device_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_backup": {
          "description": "RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Category": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "project-artifact",
            "package-cache",
            "xcode",
            "vm-container",
            "toolchain",
            "ml-model",
            "ide",
            "app-cache",
            "trash",
            "generic-cache"
          ]
        },
        {
          "description": "Photos, backups, downloads, messengers.",
          "type": "string",
          "const": "personal"
        }
      ]
    },
    "ClassTotal": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "class": {
          "$ref": "#/$defs/RiskClass"
        },
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "class",
        "count",
        "bytes",
        "selected_count",
        "selected_bytes"
      ]
    },
    "Contents": {
      "description": "The direct children of a user-data folder: the largest listed, the rest summed.",
      "type": "object",
      "properties": {
        "entries": {
          "description": "Largest first (ties by path bytes); at most 100, each at least 10 MiB.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderEntry"
          }
        },
        "rest_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rest_count": {
          "description": "The other children, findings of their own left out.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "entries",
        "rest_count",
        "rest_bytes"
      ]
    },
    "EntryLock": {
      "description": "Why an entry cannot be picked. One type in the scan report and the clean report.",
      "oneOf": [
        {
          "description": "An app manages it; clean it in that app.",
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "app-managed"
            }
          },
          "required": [
            "reason",
            "app"
          ]
        },
        {
          "description": "A `.ddc-keep` in it, or an exclude at or in it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "kept"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A protected folder (safety ADR §6) at or inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "protected"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Another volume is mounted inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "other-volume"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Added or changed within [`RECENT`] of the scan's start: in use or still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "recent"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A download still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "partial-download"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A backup whose `Status.plist` does not say it finished.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "unfinished-backup"
            }
          },
          "required": [
            "reason"
          ]
        }
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes belonging to this finding alone.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "class": {
          "description": "Effective class (may be lower than `rule_class`, see `notes`).",
          "$ref": "#/$defs/RiskClass"
        },
        "contents": {
          "description": "What one of the user's own folders holds, to pick from (story \"User\ndata: pick your own files for the Trash\"). Only on findings of\n`rules::entries::ENTRY_RULES` the scan could read.",
          "anyOf": [
            {
              "$ref": "#/$defs/Contents"
            },
            {
              "type": "null"
            }
          ]
        },
        "dev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hint": {
          "description": "How to get it back.",
          "type": "string"
        },
        "ignored": {
          "description": "Hidden by `settings.json`: its rule is switched off, or it is under\n`min_size`. Never selected and in no total; `not_selected` is unchanged.",
          "type": "boolean"
        },
        "incomplete": {
          "description": "Some content could not be read or was skipped; sizes are lower bounds.",
          "type": "boolean"
        },
        "ino": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "not_selected": {
          "description": "Why it is not selected by default. An ignored finding keeps the reason\nit would have had, so a type switched back on applies at once.",
          "anyOf": [
            {
              "$ref": "#/$defs/NotSelected"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "parent_dev": {
          "description": "Identity of the parent directory at scan time (re-checked before cleaning).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "parent_ino": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "private_bytes": {
          "description": "Lower bound of what deleting it frees (APFS private size). Present\nwhere clones are expected (uv, pnpm) and measurable.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/Project"
            },
            {
              "type": "null"
            }
          ]
        },
        "removal": {
          "$ref": "#/$defs/RemovalKind"
        },
        "rule": {
          "description": "Stable rule id (`python.venv`, `cache.uv`, …).",
          "type": "string"
        },
        "rule_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "selected": {
          "description": "Selected by default in a cleanup plan.",
          "type": "boolean"
        },
        "shared_bytes": {
          "description": "Allocated bytes of hard-linked files also linked elsewhere.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "rule",
        "category",
        "class",
        "rule_class",
        "removal",
        "bytes",
        "shared_bytes",
        "files",
        "dirs",
        "incomplete",
        "selected",
        "notes",
        "hint",
        "dev",
        "ino"
      ]
    },
    "FolderEntry": {
      "description": "One direct child of a user-data folder: a regular file or a directory.",
      "type": "object",
      "properties": {
        "backup": {
          "description": "A device backup's `Info.plist`, where it could be read.",
          "anyOf": [
            {
              "$ref": "#/$defs/Backup"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "description": "Allocated bytes, findings inside it included.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "findings": {
          "description": "Findings of other rules inside it (a folder in Downloads).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "git": {
          "description": "A folder with `.git`: a project.",
          "type": "boolean"
        },
        "incomplete": {
          "description": "Parts of it could not be read; `bytes` is a lower bound. It can still\nbe picked: the Trash keeps it.",
          "type": "boolean"
        },
        "ino": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/FolderEntryKind"
        },
        "lock": {
          "description": "Why it cannot be picked.",
          "anyOf": [
            {
              "$ref": "#/$defs/EntryLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "modified": {
          "description": "Last modification, RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "bytes",
        "dev",
        "ino"
      ]
    },
    "FolderEntryKind": {
      "type": "string",
      "enum": [
        "file",
        "folder"
      ]
    },
    "Inaccessible": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "error"
      ]
    },
    "LargeFile": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes"
      ]
    },
    "NotSelected": {
      "oneOf": [
        {
          "description": "Expensive to restore or restorability uncertain: always a manual choice.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "review"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The user's data: never planned.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "user-data"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The project changed recently.",
          "type": "object",
          "properties": {
            "idle_days": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "const": "active-project"
            }
          },
          "required": [
            "reason",
            "idle_days"
          ]
        },
        {
          "description": "No activity signal: treated as active.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "unknown-activity"
            }
          },
          "required": [
            "reason"
          ]
        }
      ]
    },
    "Note": {
      "oneOf": [
        {
          "description": "Environment without a lock file: restoring may give a different environment.",
          "type": "string",
          "const": "no-lockfile"
        },
        {
          "description": "Inside a hidden top-level folder of $HOME or ~/Library: owned by an app or tool.",
          "type": "string",
          "const": "app-owned"
        },
        {
          "description": "A `.ddc-keep` marker in it or above it.",
          "type": "string",
          "const": "kept-by-marker"
        },
        {
          "description": "Matched `--exclude`.",
          "type": "string",
          "const": "excluded"
        }
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "has_lockfile": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idle_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "last_activity": {
          "description": "Latest activity (RFC 3339): git index/HEAD, manifests, lock files.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ]
    },
    "RemovalKind": {
      "type": "string",
      "enum": [
        "delete",
        "trash",
        "native",
        "native-only",
        "none"
      ]
    },
    "RiskClass": {
      "oneOf": [
        {
          "description": "Cache that refills itself.",
          "type": "string",
          "const": "safe"
        },
        {
          "description": "Project artifact restored by install (from a lock file) or by a build.",
          "type": "string",
          "const": "rebuildable"
        },
        {
          "description": "Expensive to restore, or restorability is uncertain.",
          "type": "string",
          "const": "review"
        },
        {
          "description": "The user's data: reported, never planned.",
          "type": "string",
          "const": "user-data"
        }
      ]
    },
    "SkipReason": {
      "oneOf": [
        {
          "description": "Excluded by the visitor (`--exclude`, cloud folders, …).",
          "type": "string",
          "const": "excluded"
        },
        {
          "description": "Evicted cloud content; reading it would download it.",
          "type": "string",
          "const": "dataless"
        },
        {
          "description": "Another filesystem is mounted here.",
          "type": "string",
          "const": "other-filesystem"
        },
        {
          "description": "The directory changed between listing its parent and opening it.",
          "type": "string",
          "const": "changed"
        }
      ]
    },
    "SkippedPath": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "path",
        "reason"
      ]
    },
    "Totals": {
      "type": "object",
      "properties": {
        "classes": {
          "description": "One entry per class, in the order safe, rebuildable, review, user-data.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassTotal"
          }
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ignored_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ignored_count": {
          "description": "Findings `settings.json` hides ([`Finding::ignored`]); they are in no\nclass total above.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scanned_bytes": {
          "description": "Allocated bytes under the scan roots, each inode once.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_bytes": {
          "description": "Bytes of findings selected by default.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_reclaimable_bytes": {
          "description": "Estimate of what deleting the selected findings frees: APFS private\nsize where clones are expected and measured (uv, pnpm), allocated size\nelsewhere (no clones expected there).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unowned_bytes": {
          "description": "Bytes outside every finding.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "scanned_bytes",
        "files",
        "dirs",
        "unowned_bytes",
        "classes",
        "selected_bytes",
        "selected_reclaimable_bytes"
      ]
    },
    "Volume": {
      "type": "object",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to an unprivileged user.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mount_point": {
          "type": "string"
        },
        "roots": {
          "description": "The scan roots on this volume; the walk never crosses into another,\nso every finding under them lies on it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "mount_point",
        "roots",
        "free_bytes",
        "total_bytes"
      ]
    }
  }
}
