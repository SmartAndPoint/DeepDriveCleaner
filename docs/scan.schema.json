{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanReport",
  "type": "object",
  "properties": {
    "cancelled": {
      "type": "boolean"
    },
    "capabilities": {
      "description": "What this build can do on its platform, in declaration order. A\ncapability not listed is absent: without `private-size` no finding\nhas `private_bytes`; without `full-disk-access` `full_disk_access`\nis true.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "ddc_version": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "errors_total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "findings": {
      "description": "Ordered by class, then size (largest first), then path.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "full_disk_access": {
      "description": "True unless a permission system withheld protected data. On macOS,\nwhether the scanning process could read TCC-protected data: without\nit parts of `~/Library` are unreadable and listed in `inaccessible`.",
      "type": "boolean"
    },
    "generated_at": {
      "description": "RFC 3339, UTC.",
      "type": "string"
    },
    "home": {
      "type": "string"
    },
    "inaccessible": {
      "description": "Directories that could not be read (at most 10 000; see `errors_total`).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Inaccessible"
      }
    },
    "large_files": {
      "description": "Largest files outside every finding, for manual review.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LargeFile"
      }
    },
    "min_age_days": {
      "description": "`rebuildable` findings idle at least this long are selected by default.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "not_scanned": {
      "description": "The user's skips (`settings.json`'s `skips`, `--skip`) the walk stopped\nat, canonical, never truncated. A skip inside a claimed finding is not\nhere: the finding was read and is kept whole instead.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform": {
      "description": "The platform the CLI was built for.",
      "$ref": "#/$defs/Platform"
    },
    "scan_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkippedPath"
      }
    },
    "skipped_total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    },
    "volumes": {
      "description": "The volume of each scan root, once per volume. Absent when no volume\ncould be read.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Volume"
      }
    }
  },
  "required": [
    "schema_version",
    "ddc_version",
    "platform",
    "capabilities",
    "generated_at",
    "duration_ms",
    "home",
    "scan_roots",
    "full_disk_access",
    "min_age_days",
    "totals",
    "findings",
    "large_files",
    "inaccessible",
    "errors_total",
    "skipped",
    "skipped_total",
    "cancelled"
  ],
  "$defs": {
    "Backup": {
      "type": "object",
      "properties": {
        "device_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_backup": {
          "description": "RFC 3339.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Capability": {
      "description": "What a platform can do beyond listing, measuring and removing files\n(ADR \"Platform seam\", §3). A closed list in declaration order: a new\nvalue bumps the schema version of every report that carries the list.",
      "oneOf": [
        {
          "description": "The clone-aware private size where clones are expected (APFS).\nWithout it `private_bytes` is never present.",
          "type": "string",
          "const": "private-size"
        },
        {
          "description": "The in-use checks before a delete (safety ADR §5). Its absence is no\npermission to delete without them.",
          "type": "string",
          "const": "in-use-check"
        },
        {
          "description": "Evicted cloud files are recognised and never downloaded while scanning.",
          "type": "string",
          "const": "dataless-files"
        },
        {
          "description": "A permission system (TCC) can withhold parts of the home folder.\nWithout it `full_disk_access` is `true`.",
          "type": "string",
          "const": "full-disk-access"
        },
        {
          "description": "Local backup snapshots that delay freeing space are counted. Without\nit a clean report's `local_snapshots` is 0 and has no meaning.",
          "type": "string",
          "const": "local-snapshots"
        },
        {
          "description": "`ddc disk` and the `disk free` actions on its rows.",
          "type": "string",
          "const": "whole-disk"
        },
        {
          "description": "`ddc disk agents`.",
          "type": "string",
          "const": "coding-agents"
        },
        {
          "description": "`ddc disk brew-packages` and the `disk free` actions on its rows.",
          "type": "string",
          "const": "homebrew"
        },
        {
          "description": "`ddc schedule`.",
          "type": "string",
          "const": "schedule"
        },
        {
          "description": "The background scan shows a notification.",
          "type": "string",
          "const": "notifications"
        }
      ]
    },
    "Category": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "project-artifact",
            "package-cache",
            "xcode",
            "vm-container",
            "toolchain",
            "ml-model",
            "ide",
            "app-cache",
            "trash",
            "generic-cache"
          ]
        },
        {
          "description": "Photos, backups, downloads, messengers.",
          "type": "string",
          "const": "personal"
        }
      ]
    },
    "ClassTotal": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "class": {
          "$ref": "#/$defs/RiskClass"
        },
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "class",
        "count",
        "bytes",
        "selected_count",
        "selected_bytes"
      ]
    },
    "Contents": {
      "description": "The direct children of a folder with entries: the largest listed, the\nrest summed. A session folder's entry is a session: its transcript (or\nits folder in `file-history`) with the siblings named after it.",
      "type": "object",
      "properties": {
        "entries": {
          "description": "Largest first (ties by path bytes); at most 100. A user-data folder's\nare each at least 10 MiB; a session folder's have no floor.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderEntry"
          }
        },
        "rest_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rest_count": {
          "description": "The other children, findings of their own left out.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "entries",
        "rest_count",
        "rest_bytes"
      ]
    },
    "EntryLock": {
      "description": "Why an entry cannot be picked. One type in the scan report and the clean report.",
      "oneOf": [
        {
          "description": "An app manages it; clean it in that app.",
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "app-managed"
            }
          },
          "required": [
            "reason",
            "app"
          ]
        },
        {
          "description": "A `.ddc-keep` in it, or an exclude at or in it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "kept"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A protected folder (safety ADR §6) at or inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "protected"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Another volume is mounted inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "other-volume"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Added or changed within [`RECENT`] of the scan's start: in use or still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "recent"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A download still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "partial-download"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A backup whose `Status.plist` does not say it finished.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "unfinished-backup"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A coding agent's session that is live: a live record names it, a\nfile of it changed within [`RECENT`], or a process holds one open.\nIn place of `recent` for the session folders.",
          "type": "object",
          "properties": {
            "by": {
              "$ref": "#/$defs/LiveBy"
            },
            "reason": {
              "type": "string",
              "const": "live-session"
            },
            "session": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "session",
            "by"
          ]
        },
        {
          "description": "Whether the session is live could not be told: the harness's live\nrecords could not be read or decided.",
          "type": "object",
          "properties": {
            "cause": {
              "$ref": "#/$defs/UnknownCause"
            },
            "reason": {
              "type": "string",
              "const": "liveness-unknown"
            }
          },
          "required": [
            "reason",
            "cause"
          ]
        }
      ]
    },
    "Exclusion": {
      "description": "An exclusion or a skip that protects a finding, canonical.",
      "type": "object",
      "properties": {
        "inside": {
          "description": "The path lies inside the finding; otherwise it is the finding's own\nfolder or above it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ExclusionKind"
        },
        "origin": {
          "$ref": "#/$defs/ExclusionOrigin"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "origin",
        "inside"
      ]
    },
    "ExclusionKind": {
      "oneOf": [
        {
          "description": "Never touched (`excludes`, `--exclude`).",
          "type": "string",
          "const": "exclude"
        },
        {
          "description": "Never read (`skips`, `--skip`).",
          "type": "string",
          "const": "skip"
        }
      ]
    },
    "ExclusionOrigin": {
      "oneOf": [
        {
          "description": "`settings.json`.",
          "type": "string",
          "const": "settings"
        },
        {
          "description": "A command-line flag.",
          "type": "string",
          "const": "flag"
        }
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes belonging to this finding alone.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "class": {
          "description": "Effective class (may be lower than `rule_class`, see `notes`).",
          "$ref": "#/$defs/RiskClass"
        },
        "contents": {
          "description": "What one of the user's own folders holds, to pick from (story \"User\ndata: pick your own files for the Trash\"), or the sessions of a\ncoding agent's session folder (story \"Harness data rules\"). Only on\nfindings of a rule with an entry policy (`rules::entries::policy`)\nthe scan could read.",
          "anyOf": [
            {
              "$ref": "#/$defs/Contents"
            },
            {
              "type": "null"
            }
          ]
        },
        "dev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "hint": {
          "description": "How to get it back.",
          "type": "string"
        },
        "ignored": {
          "description": "Hidden by `settings.json`: its rule is switched off, or it is under\n`min_size`. Never selected and in no total; `not_selected` is unchanged.",
          "type": "boolean"
        },
        "incomplete": {
          "description": "Some content could not be read or was skipped; sizes are lower bounds.",
          "type": "boolean"
        },
        "ino": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "modified": {
          "description": "The newest modification time inside it, its own directory included,\nRFC 3339 in UTC to the second (story \"Review window: sort a group's\nrows by name, size or last change\"). A lower bound when `incomplete`.\nOnly inside a claim the walk read times for: none on a region, a\nuser-data finding, a protected one, an unlisted rule's, or one whose\nroot could not be opened.",
          "type": [
            "string",
            "null"
          ]
        },
        "not_selected": {
          "description": "Why it is not selected by default. An ignored finding keeps the reason\nit would have had, so a type switched back on applies at once.",
          "anyOf": [
            {
              "$ref": "#/$defs/NotSelected"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Note"
          }
        },
        "origin": {
          "description": "The harness whose own structure the rule recognizes (ADR \"Agent\nfootprint: worktrees, harness data and bounded consent for agents\",\n§1). Only on findings of such rules.",
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_dev": {
          "description": "Identity of the parent directory at scan time (re-checked before cleaning).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "parent_ino": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "private_bytes": {
          "description": "Lower bound of what deleting it frees (APFS private size). Present\nwhere clones are expected (uv, pnpm) and measurable.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/Project"
            },
            {
              "type": "null"
            }
          ]
        },
        "protection": {
          "description": "What keeps a `user.kept` finding (story \"Protected by you: say what it\nis, and Remove Protection\"). Only on those findings.",
          "anyOf": [
            {
              "$ref": "#/$defs/Protection"
            },
            {
              "type": "null"
            }
          ]
        },
        "removal": {
          "$ref": "#/$defs/RemovalKind"
        },
        "rule": {
          "description": "Stable rule id (`python.venv`, `cache.uv`, …).",
          "type": "string"
        },
        "rule_class": {
          "$ref": "#/$defs/RiskClass"
        },
        "selected": {
          "description": "Selected by default in a cleanup plan.",
          "type": "boolean"
        },
        "shared_bytes": {
          "description": "Allocated bytes of hard-linked files also linked elsewhere.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "rule",
        "category",
        "class",
        "rule_class",
        "removal",
        "bytes",
        "shared_bytes",
        "files",
        "dirs",
        "incomplete",
        "selected",
        "notes",
        "hint",
        "dev",
        "ino"
      ]
    },
    "FolderEntry": {
      "description": "One direct child of a folder with entries: a regular file or a\ndirectory. A session's entry is its key (`<session>.jsonl`, or\n`<session>/` in `file-history`), with its companions' bytes.",
      "type": "object",
      "properties": {
        "backup": {
          "description": "A device backup's `Info.plist`, where it could be read.",
          "anyOf": [
            {
              "$ref": "#/$defs/Backup"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "description": "Allocated bytes, findings inside it included; a session's, its\ncompanions' too.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "findings": {
          "description": "Findings of other rules inside it (a folder in Downloads).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "git": {
          "description": "A folder with `.git`: a project.",
          "type": "boolean"
        },
        "incomplete": {
          "description": "Parts of it could not be read; `bytes` is a lower bound. It can still\nbe picked: the Trash keeps it.",
          "type": "boolean"
        },
        "ino": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/FolderEntryKind"
        },
        "lock": {
          "description": "Why it cannot be picked.",
          "anyOf": [
            {
              "$ref": "#/$defs/EntryLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "modified": {
          "description": "Last modification, RFC 3339; a session's, the newest of its files'\nown.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "bytes",
        "dev",
        "ino"
      ]
    },
    "FolderEntryKind": {
      "type": "string",
      "enum": [
        "file",
        "folder"
      ]
    },
    "Inaccessible": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "error"
      ]
    },
    "LargeFile": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes"
      ]
    },
    "LiveBy": {
      "description": "What shows a session live. The scan report's `live-session` lock\ncarries it as `by`.",
      "oneOf": [
        {
          "description": "A live record names it.",
          "type": "string",
          "const": "record"
        },
        {
          "description": "Its transcript or a companion changed within [`entries::RECENT`]\nbefore the check, or later than it.",
          "type": "string",
          "const": "recent"
        },
        {
          "description": "A process of the user holds one of its files open.",
          "type": "string",
          "const": "open-file"
        }
      ]
    },
    "MarkerFolder": {
      "description": "A folder holding a `.ddc-keep`, with its identity at scan time.",
      "type": "object",
      "properties": {
        "dev": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "folder": {
          "type": "string"
        },
        "ino": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "folder",
        "dev",
        "ino"
      ]
    },
    "NotSelected": {
      "oneOf": [
        {
          "description": "Expensive to restore or restorability uncertain: always a manual choice.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "review"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The user's data: never planned.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "user-data"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The project changed recently.",
          "type": "object",
          "properties": {
            "idle_days": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "const": "active-project"
            }
          },
          "required": [
            "reason",
            "idle_days"
          ]
        },
        {
          "description": "No activity signal: treated as active.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "unknown-activity"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Something inside, or the folder itself, belongs to another user (a\ncontainer's root, say): never selected, never removed (safety ADR,\namendment of 2026-10-31).",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "foreign-owner"
            }
          },
          "required": [
            "reason"
          ]
        }
      ]
    },
    "Note": {
      "oneOf": [
        {
          "description": "Environment without a lock file: restoring may give a different environment.",
          "type": "string",
          "const": "no-lockfile"
        },
        {
          "description": "Inside a hidden top-level folder of $HOME or ~/Library: owned by an app or tool.",
          "type": "string",
          "const": "app-owned"
        },
        {
          "description": "A `.ddc-keep` marker in it or above it.",
          "type": "string",
          "const": "kept-by-marker"
        },
        {
          "description": "Matched `--exclude`.",
          "type": "string",
          "const": "excluded"
        }
      ]
    },
    "Origin": {
      "description": "Where a finding comes from: a coding agent's harness and what of it the\nfinding is. A provenance, not a class: the class and the method decide\nwhat happens to it.",
      "type": "object",
      "properties": {
        "harness": {
          "$ref": "#/$defs/OriginHarness"
        },
        "kind": {
          "$ref": "#/$defs/OriginKind"
        }
      },
      "required": [
        "harness",
        "kind"
      ]
    },
    "OriginHarness": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "opencode",
            "cursor"
          ]
        },
        {
          "description": "A git worktree, whoever made it.",
          "type": "string",
          "const": "git"
        }
      ]
    },
    "OriginKind": {
      "oneOf": [
        {
          "description": "A worktree an agent works in.",
          "type": "string",
          "const": "worktree"
        },
        {
          "description": "What the harness keeps of its sessions: transcripts, history, logs.",
          "type": "string",
          "const": "session-data"
        },
        {
          "description": "What the harness downloads or writes for itself and can make again.",
          "type": "string",
          "const": "runtime-cache"
        }
      ]
    },
    "Platform": {
      "description": "The operating system a build is for, as `std::env::consts::OS` names it.",
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "has_lockfile": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idle_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "last_activity": {
          "description": "Latest activity (RFC 3339): git index/HEAD, manifests, lock files.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ]
    },
    "Protection": {
      "description": "What protects a `user.kept` finding: its keep markers, the exclusions and\nskips at or above it or inside it, and the rule it displaced.",
      "type": "object",
      "properties": {
        "exclusions": {
          "description": "Sorted by path, each once.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Exclusion"
          }
        },
        "markers": {
          "description": "Each folder holding a `.ddc-keep`, the finding's own or one inside it,\nsorted by folder.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkerFolder"
          }
        },
        "rule": {
          "description": "The rule that would have claimed the folder, when the walk knows it.\nUnder an exclusion at or above the folder nothing is listed, so only a\nknown path, a region or a child of a known path is known there.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "markers",
        "exclusions"
      ]
    },
    "RemovalKind": {
      "type": "string",
      "enum": [
        "delete",
        "trash",
        "native",
        "native-only",
        "none"
      ]
    },
    "RiskClass": {
      "oneOf": [
        {
          "description": "Cache that refills itself.",
          "type": "string",
          "const": "safe"
        },
        {
          "description": "Project artifact restored by install (from a lock file) or by a build.",
          "type": "string",
          "const": "rebuildable"
        },
        {
          "description": "Expensive to restore, or restorability is uncertain.",
          "type": "string",
          "const": "review"
        },
        {
          "description": "The user's data: reported, never planned.",
          "type": "string",
          "const": "user-data"
        }
      ]
    },
    "SkipReason": {
      "oneOf": [
        {
          "description": "Excluded by the visitor (`--exclude`, cloud folders, …).",
          "type": "string",
          "const": "excluded"
        },
        {
          "description": "Evicted cloud content; reading it would download it.",
          "type": "string",
          "const": "dataless"
        },
        {
          "description": "Another filesystem is mounted here.",
          "type": "string",
          "const": "other-filesystem"
        },
        {
          "description": "The directory changed between listing its parent and opening it.",
          "type": "string",
          "const": "changed"
        }
      ]
    },
    "SkippedPath": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "path",
        "reason"
      ]
    },
    "Totals": {
      "type": "object",
      "properties": {
        "classes": {
          "description": "One entry per class, in the order safe, rebuildable, review, user-data.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassTotal"
          }
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ignored_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ignored_count": {
          "description": "Findings `settings.json` hides ([`Finding::ignored`]); they are in no\nclass total above.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "scanned_bytes": {
          "description": "Allocated bytes under the scan roots, each inode once.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_bytes": {
          "description": "Bytes of findings selected by default.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "selected_reclaimable_bytes": {
          "description": "Estimate of what deleting the selected findings frees: APFS private\nsize where clones are expected and measured (uv, pnpm), allocated size\nelsewhere (no clones expected there).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "unowned_bytes": {
          "description": "Bytes outside every finding.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "scanned_bytes",
        "files",
        "dirs",
        "unowned_bytes",
        "classes",
        "selected_bytes",
        "selected_reclaimable_bytes"
      ]
    },
    "UnknownCause": {
      "description": "Why a session's liveness could not be told. Declared from the widest\nto the narrowest: when several apply, the first is reported. The scan\nreport's `liveness-unknown` lock carries it as `cause`.",
      "oneOf": [
        {
          "description": "The records folder does not exist: an older Claude Code, or a\nchanged layout.",
          "type": "string",
          "const": "records-missing"
        },
        {
          "description": "The records folder, or an entry of it, could not be read.",
          "type": "string",
          "const": "records-unreadable"
        },
        {
          "description": "The records folder lies at or under one of the user's skips, so it\nis never opened.",
          "type": "string",
          "const": "records-skipped"
        },
        {
          "description": "A record could not be parsed.",
          "type": "string",
          "const": "unparsable-record"
        },
        {
          "description": "A record could not be decided and names no session.",
          "type": "string",
          "const": "undecidable-record"
        },
        {
          "description": "A live record names no session.",
          "type": "string",
          "const": "live-record-without-session"
        },
        {
          "description": "A record that could not be decided names this session.",
          "type": "string",
          "const": "undecidable-session-record"
        },
        {
          "description": "The session was given with no file, so nothing could be checked.",
          "type": "string",
          "const": "session-without-files"
        }
      ]
    },
    "Volume": {
      "type": "object",
      "properties": {
        "free_bytes": {
          "description": "Bytes available to an unprivileged user.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mount_point": {
          "type": "string"
        },
        "roots": {
          "description": "The scan roots on this volume; the walk never crosses into another,\nso every finding under them lies on it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "mount_point",
        "roots",
        "free_bytes",
        "total_bytes"
      ]
    }
  }
}
