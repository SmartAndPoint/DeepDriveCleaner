{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeReport",
  "description": "What `ddc disk free` did, one report per listed action in list order.",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActionReport"
      }
    },
    "ddc_version": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "journal": {
      "description": "`actions.jsonl`; absent from a dry run.",
      "type": [
        "string",
        "null"
      ]
    },
    "last_disk": {
      "description": "`last-disk.json` after any action that ran.",
      "$ref": "#/$defs/ReportEdit"
    },
    "last_scan": {
      "description": "`last-scan.json` after a `brew-cleanup` that ran.",
      "$ref": "#/$defs/ReportEdit"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "ddc_version",
    "dry_run",
    "actions",
    "last_scan",
    "last_disk"
  ],
  "$defs": {
    "ActionId": {
      "description": "The one-click tool an area can be freed with (story \"Whole disk: free\nspace with the owning tool\"); this report only names it.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "simctl-runtime-delete",
            "brew-cleanup"
          ]
        },
        {
          "description": "`conda env remove -p` of one `/opt` environment; its identifier is\nthe environment's path.",
          "type": "string",
          "const": "conda-env-remove"
        },
        {
          "description": "`conda clean` of one `/opt` install's package folder; its\nidentifier is the install's prefix.",
          "type": "string",
          "const": "conda-clean"
        },
        {
          "description": "`brew uninstall --formula` of one formula, every keg of it; its\nidentifier is the formula's `full_name` (story \"Whole disk: Homebrew\npackages, their sizes, and brew uninstall\"). No area names it.",
          "type": "string",
          "const": "brew-uninstall"
        },
        {
          "description": "`brew uninstall --formula` of the formulae a removal left needed by\nnothing; no identifier.",
          "type": "string",
          "const": "brew-uninstall-orphans"
        }
      ]
    },
    "ActionList": {
      "description": "The actions a person confirmed, as the app's sheet passes them.",
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ListedAction"
          }
        },
        "schema_version": {
          "description": "[`FREE_SCHEMA_VERSION`].",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "actions"
      ]
    },
    "ActionReport": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "area": {
          "description": "The disk report's area: `simulator-runtimes`, `homebrew` or `conda`.",
          "type": "string"
        },
        "bytes_after": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "bytes_before": {
          "description": "Allocated bytes of the folders the action frees; absent when they\nwere not measured (a skip in `settings.json`, or refused first).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "command": {
          "description": "The program and its arguments, as run (or as it would run).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "description": "`NAME=value`, added to the environment.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "kegs": {
          "description": "The kegs a `brew-uninstall` or `brew-uninstall-orphans` removes, as\nbrew listed them right before it ran, each measured by ddc.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KegReport"
          }
        },
        "needed_by": {
          "description": "What still needs a confirmed formula, when that refused it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeededBy"
          }
        },
        "output": {
          "description": "The last part of the tool's output.",
          "type": "string"
        },
        "preview": {
          "description": "The tool's own dry run; only in a dry run.",
          "anyOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "$ref": "#/$defs/ActionResult"
        },
        "terminal_command": {
          "description": "The same command for a person to paste into Terminal.",
          "type": "string"
        }
      },
      "required": [
        "action",
        "area",
        "command",
        "env",
        "terminal_command",
        "result"
      ]
    },
    "ActionResult": {
      "oneOf": [
        {
          "description": "The tool succeeded and, for a runtime, the runtime left the list.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "freed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "The runtime left the list, and its folder did not shrink; or conda\nexited 0 and the environment is still there.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "removed-not-freed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "The runtime is still listed after the timeout, or ddc was stopped\nwhile it waited. CoreSimulator's daemon may still finish it.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "still-deleting"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "The location probe refused it: nothing ran.",
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/Refusal"
            },
            "status": {
              "type": "string",
              "const": "refused"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "description": "The tool exited non-zero, timed out or was stopped.",
          "type": "object",
          "properties": {
            "needs_admin": {
              "description": "The output names a permission error: the Terminal command may\nneed an administrator.",
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "status",
            "needs_admin"
          ]
        },
        {
          "description": "A dry run: the probe passed.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "would-run"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "A stop arrived before it started.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "not-run"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "KegReport": {
      "description": "One keg of a formula brew removes.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes; absent under a skip of `settings.json`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "formula": {
          "description": "The formula's `full_name`.",
          "type": "string"
        },
        "path": {
          "description": "`<cellar>/<name>/<version>`, as brew spells the Cellar.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "formula",
        "version",
        "path"
      ]
    },
    "ListedAction": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "identifier": {
          "description": "As the disk report lists it: the runtime's asset id of\n`simctl-runtime-delete`, the environment's path of\n`conda-env-remove`, the install's prefix of `conda-clean`; as `ddc\ndisk brew-packages` lists it: the formula's `full_name` of\n`brew-uninstall`. Required on those four, refused on `brew-cleanup`\nand `brew-uninstall-orphans`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kegs": {
          "description": "The versions of the formula's kegs the person saw: `brew-uninstall`\nis refused when brew lists others right before it runs. Required on\n`brew-uninstall` only.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "names": {
          "description": "The formulae, by `full_name`, the person confirmed as needed by\nnothing. Required on `brew-uninstall-orphans` only.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    },
    "NeededBy": {
      "description": "What still needs one formula: other formulae, by `full_name`, and casks.",
      "type": "object",
      "properties": {
        "casks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formula": {
          "description": "The formula that is needed, by its `full_name`.",
          "type": "string"
        },
        "formulae": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "formula"
      ]
    },
    "Preview": {
      "description": "The tool's own dry run.",
      "type": "object",
      "properties": {
        "estimate_bytes": {
          "description": "What it would free: a runtime's measured folder, or what `brew\ncleanup -n` says it would free.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "lines": {
          "description": "Its output, line by line, as printed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "lines"
      ]
    },
    "Refusal": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "not-deletable",
            "no-developer-tools"
          ]
        },
        {
          "description": "No runtime, or more than one, has this identifier.",
          "type": "string",
          "const": "unknown-runtime"
        },
        {
          "description": "Its `parentMountPath` is not under `/System/Library/AssetsV2/`.",
          "type": "string",
          "const": "not-under-assets"
        },
        {
          "description": "Already in the state `Deleting`.",
          "type": "string",
          "const": "deleting"
        },
        {
          "description": "No `runtimeIdentifier`: its devices cannot be joined to it.",
          "type": "string",
          "const": "no-runtime-identifier"
        },
        {
          "description": "A device on it is not shut down: booted, booting or shutting down.",
          "type": "string",
          "const": "booted"
        },
        {
          "description": "`simctl list devices -j` failed.",
          "type": "string",
          "const": "devices-unknown"
        },
        {
          "description": "Its `path` lies in no `<hash>.asset` folder under AssetsV2.",
          "type": "string",
          "const": "no-asset-folder"
        },
        {
          "description": "Xcode has not finished its first launch.",
          "type": "string",
          "const": "first-launch-pending"
        },
        {
          "description": "`simctl` is missing, or `runtime list` failed.",
          "type": "string",
          "const": "simctl-failed"
        },
        {
          "description": "No `/opt/homebrew/bin/brew`, or it would not say where it lives.",
          "type": "string",
          "const": "brew-missing"
        },
        {
          "description": "`brew --prefix` is not the Homebrew area's folder.",
          "type": "string",
          "const": "prefix-mismatch"
        },
        {
          "description": "`brew --cellar` is not inside the prefix.",
          "type": "string",
          "const": "cellar-outside"
        },
        {
          "description": "`brew --cache` is not `~/Library/Caches/Homebrew`.",
          "type": "string",
          "const": "cache-mismatch"
        },
        {
          "description": "The environment lies in the home folder: the Review window cleans it.",
          "type": "string",
          "const": "conda-in-home"
        },
        {
          "description": "Not one of `/opt/miniconda3`, `/opt/anaconda3`, `/opt/miniforge3`\n(an environment: not in its `envs` folder), by device and inode; or\na path conda cannot be given (not UTF-8, or holding a comma).",
          "type": "string",
          "const": "conda-not-in-opt"
        },
        {
          "description": "The install has no `bin/conda`, or its `config --show` failed or\nprinted what ddc cannot read.",
          "type": "string",
          "const": "conda-missing"
        },
        {
          "description": "conda's `root_prefix` is not the install's folder.",
          "type": "string",
          "const": "conda-root-mismatch"
        },
        {
          "description": "The install's base environment.",
          "type": "string",
          "const": "conda-base"
        },
        {
          "description": "Its parent is not in conda's `envs_dirs`.",
          "type": "string",
          "const": "conda-not-in-envs-dirs"
        },
        {
          "description": "It holds no `conda-meta/history`.",
          "type": "string",
          "const": "conda-not-an-environment"
        },
        {
          "description": "The install's `pkgs` is not in conda's `pkgs_dirs`.",
          "type": "string",
          "const": "conda-packages-not-listed"
        },
        {
          "description": "The user cannot write it: conda needs an administrator.",
          "type": "string",
          "const": "conda-not-writable"
        },
        {
          "description": "A running process uses the environment.",
          "type": "string",
          "const": "conda-in-use"
        },
        {
          "description": "An install that lists the package folder links packages into\nenvironments by symlink.",
          "type": "string",
          "const": "conda-softlinks"
        },
        {
          "description": "conda's package folders, set in a `.condarc`, cannot be limited to\nthis one.",
          "type": "string",
          "const": "conda-not-scoped"
        },
        {
          "description": "brew no longer lists the formula as installed.",
          "type": "string",
          "const": "brew-not-installed"
        },
        {
          "description": "The formula is pinned.",
          "type": "string",
          "const": "brew-pinned"
        },
        {
          "description": "brew lists other versions of it than the person confirmed.",
          "type": "string",
          "const": "brew-kegs-changed"
        },
        {
          "description": "An installed formula or cask still needs it.",
          "type": "string",
          "const": "brew-needed"
        },
        {
          "description": "A formula confirmed as needed by nothing was installed on request.",
          "type": "string",
          "const": "brew-not-orphan"
        },
        {
          "description": "A service of the user's is loaded for it.",
          "type": "string",
          "const": "brew-service-running"
        },
        {
          "description": "A root service is registered for it.",
          "type": "string",
          "const": "brew-service-root"
        },
        {
          "description": "The user's service is registered but not running.",
          "type": "string",
          "const": "brew-service-registered"
        },
        {
          "description": "brew listed a formula without a field ddc needs: what needs what\nis not known.",
          "type": "string",
          "const": "brew-field-missing"
        }
      ]
    },
    "ReportEdit": {
      "description": "What happened to a saved report after the run.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "edited"
          ]
        },
        {
          "description": "Nothing that ran touched it, or a dry run.",
          "type": "string",
          "const": "unchanged"
        },
        {
          "description": "Absent, or of another schema version or other roots: left alone.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "It could not be written; the run's own report is still right.",
          "type": "string",
          "const": "failed"
        }
      ]
    }
  }
}
