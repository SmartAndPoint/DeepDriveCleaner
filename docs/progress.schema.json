{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressLine",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "A phase begins; never held back.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "phase"
        }
      },
      "$ref": "#/$defs/PhaseEvent",
      "required": [
        "event"
      ]
    },
    {
      "description": "A walk's counters: at most one every 100 ms, plus each step's final one.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "walk"
        }
      },
      "$ref": "#/$defs/WalkEvent",
      "required": [
        "event"
      ]
    },
    {
      "description": "The clean's item counters: at most one every 100 ms, plus a final one.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "items"
        }
      },
      "$ref": "#/$defs/ItemsEvent",
      "required": [
        "event"
      ]
    },
    {
      "description": "One item's outcome, after its journal record; never held back.",
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "item"
        }
      },
      "$ref": "#/$defs/ItemEvent",
      "required": [
        "event"
      ]
    }
  ],
  "required": [
    "schema_version"
  ],
  "$defs": {
    "ActionKind": {
      "description": "An action as the app and the clean report name it.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "delete",
            "trash"
          ]
        },
        {
          "description": "The tool's own command, or the rule's fallback where the tool is missing\nor reports another location.",
          "type": "string",
          "const": "native"
        },
        {
          "description": "Only the tool's commands.",
          "type": "string",
          "const": "native-only"
        }
      ]
    },
    "AgentLiveBy": {
      "description": "What shows a harness in use, for [`SkipReason::AgentLive`].",
      "oneOf": [
        {
          "description": "A process of the harness runs.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "A process of the user holds a Codex thread lock open.",
          "type": "string",
          "const": "lock-held"
        },
        {
          "description": "It could not be told: a process of the harness ddc cannot name, or\nCodex's locks could not be read.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "BuildBy": {
      "description": "Why a build is in use.",
      "oneOf": [
        {
          "description": "A launcher points to it.",
          "type": "string",
          "const": "launcher"
        },
        {
          "description": "A process of the user runs it.",
          "type": "string",
          "const": "process"
        },
        {
          "description": "Claude Code's installer lock names a live process for it.",
          "type": "string",
          "const": "lock"
        },
        {
          "description": "The newest build.",
          "type": "string",
          "const": "newest"
        }
      ]
    },
    "BuildsCause": {
      "description": "Why no build of a harness can be told free: each locks them all.",
      "oneOf": [
        {
          "description": "No launcher: the build in use cannot be told.",
          "type": "string",
          "const": "no-launcher"
        },
        {
          "description": "The launcher does not resolve inside the folder (a custom one, or\nbuilds moved by `XDG_DATA_HOME`).",
          "type": "string",
          "const": "custom-launcher"
        },
        {
          "description": "A process of the user named as the harness could not be inspected.",
          "type": "string",
          "const": "process-withheld"
        },
        {
          "description": "A readable process of another user carries the harness's name.",
          "type": "string",
          "const": "other-user-process"
        },
        {
          "description": "`/proc` hides other users' processes (Linux `hidepid`).",
          "type": "string",
          "const": "hidden-process-table"
        },
        {
          "description": "The home is on a network filesystem, which other machines may run builds from.",
          "type": "string",
          "const": "network-home"
        }
      ]
    },
    "CommandResult": {
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "output": {
          "description": "Last part of the command's output, for the journal.",
          "type": "string"
        },
        "program": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "program",
        "args",
        "success"
      ]
    },
    "CurrentEvent": {
      "description": "The item in flight.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "i": {
          "description": "1-based, of `n`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "tool": {
          "description": "The tool whose command (or location probe) runs now.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "i",
        "path",
        "action",
        "bytes"
      ]
    },
    "EntryLock": {
      "description": "Why an entry cannot be picked. One type in the scan report and the clean report.",
      "oneOf": [
        {
          "description": "An app manages it; clean it in that app.",
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "app-managed"
            }
          },
          "required": [
            "reason",
            "app"
          ]
        },
        {
          "description": "A `.ddc-keep` in it, or an exclude at or in it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "kept"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A protected folder (safety ADR §6) at or inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "protected"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Another volume is mounted inside it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "other-volume"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "It, or something inside it, has an immutable or append-only flag: its\nowner cannot remove it (safety ADR, amendment of 2026-11-04, \"Linux\nfile kinds\").",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "immutable"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Added or changed within [`RECENT`] of the scan's start: in use or still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "recent"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A download still arriving.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "partial-download"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A backup whose `Status.plist` does not say it finished.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "unfinished-backup"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A coding agent's session that is live: a live record names it, a\nfile of it changed within [`RECENT`], or a process holds one open.\nIn place of `recent` for the session folders.",
          "type": "object",
          "properties": {
            "by": {
              "$ref": "#/$defs/LiveBy"
            },
            "reason": {
              "type": "string",
              "const": "live-session"
            },
            "session": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "session",
            "by"
          ]
        },
        {
          "description": "Whether the session is live could not be told: the harness's live\nrecords could not be read or decided.",
          "type": "object",
          "properties": {
            "cause": {
              "$ref": "#/$defs/UnknownCause"
            },
            "reason": {
              "type": "string",
              "const": "liveness-unknown"
            }
          },
          "required": [
            "reason",
            "cause"
          ]
        },
        {
          "description": "A coding agent's build still needed: a launcher points to it, a\nprocess of the user runs it, its installer lock names a live process,\nor it is the newest.",
          "type": "object",
          "properties": {
            "by": {
              "$ref": "#/$defs/BuildBy"
            },
            "reason": {
              "type": "string",
              "const": "build-in-use"
            }
          },
          "required": [
            "reason",
            "by"
          ]
        },
        {
          "description": "Whether any build of the harness is still needed could not be told:\nevery build is locked.",
          "type": "object",
          "properties": {
            "cause": {
              "$ref": "#/$defs/BuildsCause"
            },
            "reason": {
              "type": "string",
              "const": "builds-unknown"
            }
          },
          "required": [
            "reason",
            "cause"
          ]
        }
      ]
    },
    "HarnessId": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "cursor",
        "opencode"
      ]
    },
    "ItemEvent": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionKind"
        },
        "bytes": {
          "description": "Allocated bytes as the clean's re-check measured them.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "i": {
          "description": "1-based, of `n`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "deleted"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "trashed"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "description": "Asked to go to the Recycle Bin, the item is gone and is not there:\nthe shell destroyed it instead (Windows only, safety ADR §5, the\nRecycle Bin on Windows). Its space is freed, so it is not `failed`;\nwithout `--json` the clean still exits 1.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "removed-not-recycled"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommandResult"
              }
            },
            "outcome": {
              "type": "string",
              "const": "native"
            }
          },
          "required": [
            "outcome",
            "commands"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "skipped"
            }
          },
          "$ref": "#/$defs/SkipReason",
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "outcome",
            "error"
          ]
        },
        {
          "description": "Left by a cancel before it started; never journaled.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "not-run"
            }
          },
          "required": [
            "outcome"
          ]
        }
      ],
      "required": [
        "i",
        "n",
        "path",
        "action",
        "bytes"
      ]
    },
    "ItemsEvent": {
      "type": "object",
      "properties": {
        "bytes_done": {
          "description": "Bytes of the items done, whatever their outcome; `native-only` items\nare in neither byte figure (their space is freed inside a VM image).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes_total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurrentEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "done": {
          "description": "Items with an outcome; `not-run` items are not counted.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "n": {
          "description": "Items the executor runs; items refused at the re-check are only in the report.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "done",
        "n",
        "bytes_done",
        "bytes_total"
      ]
    },
    "LiveBy": {
      "description": "What shows a session live. The scan report's `live-session` lock\ncarries it as `by`.",
      "oneOf": [
        {
          "description": "A live record names it.",
          "type": "string",
          "const": "record"
        },
        {
          "description": "Its transcript or a companion changed within [`entries::RECENT`]\nbefore the check, or later than it.",
          "type": "string",
          "const": "recent"
        },
        {
          "description": "A process of the user holds one of its files open.",
          "type": "string",
          "const": "open-file"
        }
      ]
    },
    "Phase": {
      "oneOf": [
        {
          "description": "After the lock, before the clean's re-check walk.",
          "type": "string",
          "const": "preparing"
        },
        {
          "description": "Immediately before the first action: from here on the clean may touch\nfiles. Written even when no item runs.",
          "type": "string",
          "const": "cleaning"
        }
      ]
    },
    "PhaseEvent": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/Phase"
        }
      },
      "required": [
        "phase"
      ]
    },
    "RecycleBinCause": {
      "description": "Why the Recycle Bin refuses an item (safety ADR §5, the Recycle Bin on\nWindows, planned 2026-11-04). Nothing moved; `--permanent` removes it\ninstead.",
      "oneOf": [
        {
          "description": "The item's volume has no Recycle Bin: not a local fixed drive, or\nthe shell finds none there.",
          "type": "string",
          "const": "no-bin"
        },
        {
          "description": "The item is larger than the bin's maximum size.",
          "type": "string",
          "const": "too-large"
        },
        {
          "description": "The item fits the bin's maximum, not the room left in it: Windows\nwould destroy the user's oldest recycled items to make room.",
          "type": "string",
          "const": "bin-full"
        },
        {
          "description": "The volume's bin deletes at once (`NukeOnDelete`).",
          "type": "string",
          "const": "nuke-on-delete"
        },
        {
          "description": "A policy turns the Recycle Bin off (`NoRecycleFiles`).",
          "type": "string",
          "const": "no-recycle-files"
        },
        {
          "description": "The shell does not take the item's path (longer than `MAX_PATH`).",
          "type": "string",
          "const": "path-refused"
        },
        {
          "description": "A setting the checks need could not be read: refused, never guessed.",
          "type": "string",
          "const": "settings-unreadable"
        },
        {
          "description": "The shell would delete or copy the item instead of recycling it.",
          "type": "string",
          "const": "would-destroy"
        }
      ]
    },
    "SkipReason": {
      "description": "Why an item was left alone. Serialized into the journal and the clean report.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "missing"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "not-a-directory"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "symlink"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Same path, different directory than the scan saw.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "changed-since-scan"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A symlink or another directory now sits above the finding.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "parent-changed"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The rule's marker no longer matches.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "rule-mismatch"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "outside-scan-roots"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "scan-root"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "protected"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "project-root"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "`.ddc-keep` in it or above it.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "kept"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "int32"
            },
            "reason": {
              "type": "string",
              "const": "in-use"
            }
          },
          "required": [
            "reason",
            "pid",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "int32"
            },
            "reason": {
              "type": "string",
              "const": "in-use-unknown-cwd"
            }
          },
          "required": [
            "reason",
            "pid",
            "name"
          ]
        },
        {
          "description": "Another process holds the folder (Windows only, safety ADR §5,\namendment of 2026-11-02): a process works inside it, or a file below\nit is open, so the tombstone rename, or the Recycle Bin's move, was\nrefused. Nothing moved.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "held-open"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "An app that owns the item is running; `name` is its bundle name.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "int32"
            },
            "reason": {
              "type": "string",
              "const": "owner-running"
            }
          },
          "required": [
            "reason",
            "pid",
            "name"
          ]
        },
        {
          "description": "`review` and `native-only` items need an interactive confirmation.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "needs-confirmation"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The plan asks for a method the rule does not allow (user data,\nreport-only, a VM runtime with anything but its prune commands).",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "action-not-allowed"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Part of it could not be read or another filesystem is mounted inside.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "incomplete"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Something inside, or the folder itself, belongs to another user\n(safety ADR, amendment of 2026-10-31): refused before any rename.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "foreign-owner"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "Something inside, or the item itself, has an immutable or\nappend-only flag (safety ADR, amendment of 2026-11-04, \"Linux file\nkinds\"): refused before any rename. ddc never clears the flag.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "immutable"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "`ddc agent clean` (ADR \"Agent footprint\", §7): an agent may not remove\nit; a `rebuildable`, `review` or `user-data` item, a `safe` item that\nis not a project artifact, a tool's command, or one outside the\nproject's checkouts. A person's `ddc clean` may.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "not-consented"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "`ddc agent clean`: a `safe` item an agent could remove, but\n`agents_clean_safe` is off in `settings.json`.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "agent-opt-in-off"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "program": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "native-unavailable"
            }
          },
          "required": [
            "reason",
            "program"
          ]
        },
        {
          "description": "The runtime did not answer before its prune commands; nothing ran.\n`detail` says why: not running, no context, or the tool's last line.",
          "type": "object",
          "properties": {
            "detail": {
              "type": "string"
            },
            "program": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "tool-not-ready"
            }
          },
          "required": [
            "reason",
            "program",
            "detail"
          ]
        },
        {
          "description": "A picked user-data item that is no longer an entry of its folder.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "not-an-entry"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "A picked entry that is locked now.",
          "type": "object",
          "properties": {
            "lock": {
              "$ref": "#/$defs/EntryLock"
            },
            "reason": {
              "type": "string",
              "const": "entry-locked"
            }
          },
          "required": [
            "reason",
            "lock"
          ]
        },
        {
          "description": "Inside an entry of the same list that went to the Trash.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "inside-another-item"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "No Trash on the item's own filesystem that ddc may use, or the move\nwould cross into another (safety ADR §5, amendment of 2026-11-01):\nnothing moved. `--permanent` removes it instead.",
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "trash-crosses-filesystem"
            }
          },
          "required": [
            "reason"
          ]
        },
        {
          "description": "The Recycle Bin refuses the item, for `cause` (Windows only, safety\nADR §5, the Recycle Bin on Windows, planned 2026-11-04): nothing\nmoved. `--permanent` removes it instead.",
          "type": "object",
          "properties": {
            "cause": {
              "$ref": "#/$defs/RecycleBinCause"
            },
            "reason": {
              "type": "string",
              "const": "recycle-bin-refuses"
            }
          },
          "required": [
            "reason",
            "cause"
          ]
        },
        {
          "description": "A coding agent's harness uses its data: the whole folder is refused\nwhile it runs (ADR \"Agent footprint: worktrees, harness data and\nbounded consent for agents\", §3).",
          "type": "object",
          "properties": {
            "by": {
              "$ref": "#/$defs/AgentLiveBy"
            },
            "harness": {
              "$ref": "#/$defs/HarnessId"
            },
            "reason": {
              "type": "string",
              "const": "agent-live"
            }
          },
          "required": [
            "reason",
            "harness",
            "by"
          ]
        },
        {
          "description": "A linked worktree that one of the six conditions of ADR \"Agent\nfootprint\", §2, holds back, re-checked right before `git worktree\nremove` (decision 8 of story \"Worktree findings and provenance\"):\n`condition` is its number, 1 to 6, `detail` says why in words.",
          "type": "object",
          "properties": {
            "condition": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "detail": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "const": "worktree-kept"
            }
          },
          "required": [
            "reason",
            "condition",
            "detail"
          ]
        }
      ]
    },
    "UnknownCause": {
      "description": "Why a session's liveness could not be told. Declared from the widest\nto the narrowest: when several apply, the first is reported. The scan\nreport's `liveness-unknown` lock carries it as `cause`.",
      "oneOf": [
        {
          "description": "The records folder does not exist: an older Claude Code, or a\nchanged layout.",
          "type": "string",
          "const": "records-missing"
        },
        {
          "description": "The records folder, or an entry of it, could not be read.",
          "type": "string",
          "const": "records-unreadable"
        },
        {
          "description": "The records folder lies at or under one of the user's skips, so it\nis never opened.",
          "type": "string",
          "const": "records-skipped"
        },
        {
          "description": "A record could not be parsed.",
          "type": "string",
          "const": "unparsable-record"
        },
        {
          "description": "A record could not be decided and names no session.",
          "type": "string",
          "const": "undecidable-record"
        },
        {
          "description": "A live record names no session.",
          "type": "string",
          "const": "live-record-without-session"
        },
        {
          "description": "A record that could not be decided names this session.",
          "type": "string",
          "const": "undecidable-session-record"
        },
        {
          "description": "The session was given with no file, so nothing could be checked.",
          "type": "string",
          "const": "session-without-files"
        }
      ]
    },
    "WalkEvent": {
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Allocated bytes so far; a hard-linked file counts once per link until\nthe final tick, which carries the report's totals.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files_expected": {
          "description": "An estimate: for `recheck`, the previous report's files when the\nwhole tree is walked, and its listed findings' files (with the\nsiblings they are judged by) when the walk is pruned to the list;\nfor `markers`, the executed items' files. Nested items count twice, a\nregion counts less, a picked entry counts none. Absent for `scan`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "step": {
          "$ref": "#/$defs/WalkStep"
        }
      },
      "required": [
        "step",
        "files",
        "dirs",
        "bytes"
      ]
    },
    "WalkStep": {
      "oneOf": [
        {
          "description": "`ddc scan`.",
          "type": "string",
          "const": "scan"
        },
        {
          "description": "The clean's re-check of the disk before its plan.",
          "type": "string",
          "const": "recheck"
        },
        {
          "description": "The clean's walk of the chosen items for keep markers.",
          "type": "string",
          "const": "markers"
        },
        {
          "description": "`ddc disk`: the whole disk, size only.",
          "type": "string",
          "const": "disk"
        }
      ]
    }
  }
